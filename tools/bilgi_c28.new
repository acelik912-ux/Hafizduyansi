  '=örtülüsofra': ['Mücâdele 4’te zıhar kefareti için altmış yoksulu doyurmak gerektiği bildirilir.', 'Kapaklarla örtülü yemekli sofra bu doyurmayı hatırlatır.', 'Görsel anlatımdır.'],
  '=yeraçılanmeclis': ['Mücâdele 11’de mecliste birbirine yer açılması istenir ve Allah’ın da size yer açacağı bildirilir.', 'Minderleri ve sofrasıyla bu sofra bir meclis düzenini gösterir.', 'Görsel anlatımdır.'],
  '=yıkıkduvarlar': ['Mücâdele’de Allah’a ve Peygamber’ine karşı gelenlerin alçaltılacağı bildirilir.', 'Boşluklu ve yıkılmaya yüz tutmuş duvarlar bu sonucu hatırlatır.', 'Görsel anlatımdır.'],
  '=yıkılmışev': ['Haşr 2’de bazılarının evlerini kendi elleriyle yıktığı anlatılır; bu görsel genel bir hatırlatmadır.', 'Çatısı çökmüş, duvarları dökülmüş ev yıkılış fikrini gösterir.', 'Görsel anlatımdır.'],
  '=duvarlıev': ['Haşr 2 ve 14’te sağlam sanılan kalelerden ve duvarların ardında olmaktan söz edilir.', 'Duvarla çevrili ev bu güven duygusunu gösterir.', 'Görsel anlatımdır.'],
  '=ıslaktaşvetesti': ['Haşr 21’de Kur’ân’ın bir dağa indirilseydi, dağın Allah korkusundan parçalanacağı bildirilir.', 'Büyük taş ve su testisi bu ağırlığı ve su fikrini hatırlatır; ayrıntı genel bir yorumdur.', 'Görsel anlatımdır.'],
  '=taşlevhavetesti': ['Haşr 21’de dağın Kur’ân karşısında boyun eğeceği anlatılır.', 'Levha gibi taş ve yanındaki testi bu sahneyi sade bir dille gösterir.', 'Görsel anlatımdır.'],
  '=ışıklıtaşlar': ['Mümtehine’de sevgi ve dostluğun kime duyulacağı ayrıntılı biçimde anlatılır.', 'Taşların üstündeki ışık, kalpte yanan sevgiyi hatırlatır; ayrıntı genel bir yorumdur.', 'Görsel anlatımdır.'],
  '=kapıveekmeksepeti': ['Mümtehine 8’de savaşmayanlara iyilik etmek ve adil davranmak yasaklanmaz.', 'Kapıdaki ekmek sepeti bu iyiliği hatırlatır.', 'Görsel anlatımdır.'],
  '=taşçanak': ['Mümtehine’de inanan kadınların biat etmesi anlatılır.', 'Yalın taş çanak bu sade ahdi hatırlatır; ayrıntı genel bir yorumdur.', 'Görsel anlatımdır.'],
  '=sıralıtaşarabaları': ['Saff 4’te Allah yolunda saf bağlayıp savaşanları sevdiği bildirilir.', 'Sıra sıra dizilmiş arabalar bu düzeni hatırlatır.', 'Görsel anlatımdır.'],
  '=kenetlitaşduvar': ['Saff 4’te kurşunla kenetlenmiş bir bina gibi saf tutanlar anlatılır.', 'Metal kenetli taş duvar bu bütünlüğü gösterir.', 'Görsel anlatımdır.'],
  '=pazaryerivekapı': ['Cuma 9–11’de cuma ezanında alışverişi bırakıp namaza koşmak istenir.', 'Pazar tezgâhı ve açık kapı bu çağrıyı gösterir.', 'Görsel anlatımdır.'],
  '=çürükkereste': ['Münâfikûn 4’te münafıklar duvara dayanmış kerestelere benzetilir.', 'Duvara dayalı, çürümüş tahtalar bu benzetmeyi gösterir.', 'Görsel anlatımdır.'],
  '=dörtakarsulhavuz': ['Teğâbün’de Allah’ın yaratışı ve mülkü anlatılır; bu görsel genel bir hatırlatmadır.', 'Dört yöne akan sular bir havuzda toplanarak bereketi gösterir.', 'Görsel anlatımdır.'],
  '=kilkaplar': ['Teğâbün 16–17’de gücünüz yettiğince infak etmek ve Allah’a güzel borç vermek istenir.', 'Dolu ve boş kaplar verilebilen ve verilmeyeni gösterir.', 'Görsel anlatımdır.'],
  '=boyuazalankazıklar': ['Talâk 1’de iddetin sayılması ve sınırların gözetilmesi istenir.', 'Boyu sırayla kısalan kazıklar günlerin sayılmasını hatırlatır.', 'Görsel anlatımdır.'],
  '=taşyolveçiçekyolu': ['Talâk 2–3’te Allah’tan korkan için bir çıkış yolu açılacağı ve ummadığı yerden rızık verileceği bildirilir.', 'İki farklı yol bu çıkışı gösterir.', 'Görsel anlatımdır.'],
  '=testidendökülensu': ['Tahrîm’de inananlara ev halkını ateşten korumaları öğütlenir; bu görsel genel bir hatırlatmadır.', 'Testiden büyük küpe dökülen su ihtiyacı ve paylaşımı gösterir.', 'Görsel anlatımdır.'],
  '=sarmaltaşyol': ['Tahrîm 8’de samimi bir tövbe ile Allah’a dönülmesi istenir.', 'İçe doğru sarılan yol dönüşü hatırlatır.', 'Görsel anlatımdır.'],
